{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-skills.local/schemas/skill-metadata.schema.json",
  "title": "AI Skills Metadata",
  "description": "Canonical metadata contract for all three skill hierarchy levels.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill_id",
    "name",
    "description",
    "version",
    "skill_level",
    "priority",
    "status",
    "activation",
    "technology_scope",
    "tags"
  ],
  "properties": {
    "skill_id": {
      "type": "string",
      "pattern": "^(DOMAIN|SUBDOMAIN|ATOMIC)-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 300
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "skill_level": {
      "enum": ["DOMAIN", "SUBDOMAIN", "ATOMIC"]
    },
    "parent_domain": {
      "type": ["string", "null"]
    },
    "parent_subdomain": {
      "type": ["string", "null"]
    },
    "priority": {
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "status": {
      "enum": [
        "NOT STARTED",
        "RESEARCHING",
        "RESEARCH COMPLETE",
        "DRAFTING",
        "IN REVIEW",
        "VALIDATING",
        "APPROVED",
        "BLOCKED"
      ]
    },
    "activation": {
      "const": "ON_DEMAND"
    },
    "technology_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "last_verified": {
      "type": ["string", "null"],
      "format": "date"
    },
    "research_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^RESEARCH-[A-Z0-9-]+$"
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "skill_level": { "const": "DOMAIN" }
        },
        "required": ["skill_level"]
      },
      "then": {
        "properties": {
          "skill_id": { "pattern": "^DOMAIN-" },
          "parent_domain": { "type": "null" },
          "parent_subdomain": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "skill_level": { "const": "SUBDOMAIN" }
        },
        "required": ["skill_level"]
      },
      "then": {
        "required": ["parent_domain"],
        "properties": {
          "skill_id": { "pattern": "^SUBDOMAIN-" },
          "parent_domain": { "type": "string", "minLength": 1 },
          "parent_subdomain": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "skill_level": { "const": "ATOMIC" }
        },
        "required": ["skill_level"]
      },
      "then": {
        "required": ["parent_domain", "parent_subdomain"],
        "properties": {
          "skill_id": { "pattern": "^ATOMIC-" },
          "parent_domain": { "type": "string", "minLength": 1 },
          "parent_subdomain": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
