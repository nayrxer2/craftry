{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-skills.local/schemas/evaluation.schema.json",
  "title": "AI Skills Evaluation Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluation_id",
    "skill_id",
    "version",
    "status",
    "scenarios",
    "scorecard",
    "passing_threshold",
    "critical_failure_policy"
  ],
  "properties": {
    "evaluation_id": {
      "type": "string",
      "pattern": "^EVAL-[A-Z0-9-]+$"
    },
    "skill_id": {
      "type": "string",
      "pattern": "^ATOMIC-[A-Z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": {
      "enum": [
        "NOT STARTED",
        "IN REVIEW",
        "VALIDATING",
        "PASSED",
        "FAILED",
        "BLOCKED"
      ]
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "scenario_type",
          "input",
          "expected_behavior",
          "failure_conditions",
          "result"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^CASE-[A-Z0-9-]+$"
          },
          "scenario_type": {
            "enum": [
              "NORMAL",
              "EDGE_CASE",
              "INCORRECT_ASSUMPTION",
              "ANTI_PATTERN",
              "CONFLICT",
              "NON_ACTIVATION"
            ]
          },
          "input": {
            "type": "string",
            "minLength": 5
          },
          "expected_behavior": {
            "type": "string",
            "minLength": 5
          },
          "failure_conditions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "result": {
            "enum": ["NOT_RUN", "PASSED", "FAILED", "BLOCKED"]
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "scorecard": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "weight", "score", "critical"],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 3
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "score": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 100
          },
          "critical": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "passing_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "critical_failure_policy": {
      "const": "ANY_CRITICAL_FAILURE_FAILS_EVALUATION"
    },
    "evaluation_notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
