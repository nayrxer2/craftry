{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-skills.local/schemas/dependency.schema.json",
  "title": "AI Skills Dependency Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill_id", "dependencies"],
  "properties": {
    "skill_id": {
      "type": "string",
      "pattern": "^ATOMIC-[A-Z0-9-]+$"
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill_id", "type", "condition", "justification"],
        "properties": {
          "skill_id": {
            "type": "string",
            "pattern": "^ATOMIC-[A-Z0-9-]+$"
          },
          "type": {
            "enum": ["HARD", "CONDITIONAL", "RELATED"]
          },
          "condition": {
            "type": "string",
            "minLength": 5
          },
          "justification": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  }
}
