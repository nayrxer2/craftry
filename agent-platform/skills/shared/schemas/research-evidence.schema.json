{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-skills.local/schemas/research-evidence.schema.json",
  "title": "AI Skills Research Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "research_id",
    "skill_id",
    "version",
    "status",
    "sources",
    "findings",
    "instruction_mappings",
    "limitations"
  ],
  "properties": {
    "research_id": {
      "type": "string",
      "pattern": "^RESEARCH-[A-Z0-9-]+$"
    },
    "skill_id": {
      "type": "string",
      "pattern": "^ATOMIC-[A-Z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": {
      "enum": [
        "RESEARCHING",
        "RESEARCH COMPLETE",
        "IN REVIEW",
        "APPROVED",
        "BLOCKED"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "title",
          "source_type",
          "access_status",
          "verification_status"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^EVD-[A-Z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 2
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "publisher": {
            "type": ["string", "null"]
          },
          "source_type": {
            "enum": [
              "COURSE",
              "BOOK",
              "OFFICIAL_DOCUMENTATION",
              "STANDARD",
              "ACADEMIC_PUBLICATION",
              "TECHNICAL_SPECIFICATION",
              "CASE_STUDY",
              "IMPLEMENTATION_EXAMPLE",
              "OTHER"
            ]
          },
          "access_status": {
            "enum": [
              "CURRICULUM_INSPECTED",
              "PARTIALLY_EXAMINED",
              "MATERIALS_EXAMINED",
              "FULLY_EXAMINED",
              "INACCESSIBLE"
            ]
          },
          "verification_status": {
            "enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNVERIFIED"]
          },
          "accessed_date": {
            "type": ["string", "null"],
            "format": "date"
          },
          "limitations": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "claim",
          "evidence_ids",
          "confidence",
          "limitations"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^FIND-[A-Z0-9-]+$"
          },
          "claim": {
            "type": "string",
            "minLength": 10
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^EVD-[A-Z0-9-]+$"
            }
          },
          "confidence": {
            "enum": ["HIGH", "MEDIUM", "LOW"]
          },
          "limitations": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "instruction_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "target_section",
          "instruction",
          "verification_status"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^FIND-[A-Z0-9-]+$"
          },
          "target_section": {
            "type": "string",
            "minLength": 2
          },
          "instruction": {
            "type": "string",
            "minLength": 10
          },
          "verification_status": {
            "enum": ["PENDING", "VERIFIED", "REJECTED"]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
